[Unit]
Description=NX769J 3-Mode Performance & Thermal Profile Daemon (Eco / Balanced / Diablo-Turbo)
After=systemd-modules-load.service systemd-udevd.service nx769j-fan-init.service
Wants=systemd-modules-load.service nx769j-fan-init.service
Before=nx769j-powerkey.service nx769j-omamobile-session.service

[Service]
Type=simple
ExecStartPre=-/usr/bin/modprobe cpufreq_powersave
ExecStartPre=/bin/sh -c 'if [ ! -x /usr/local/bin/nx769j-perf ] || [ /usr/local/src/nx769j_perf.c -nt /usr/local/bin/nx769j-perf ]; then /usr/bin/gcc -std=c11 -O2 -Wall -Wextra -Werror /usr/local/src/nx769j_perf.c -o /usr/local/bin/nx769j-perf.new && mv -f /usr/local/bin/nx769j-perf.new /usr/local/bin/nx769j-perf && chmod 0755 /usr/local/bin/nx769j-perf; fi'
ExecStart=/usr/local/bin/nx769j-perf daemon
Restart=always
RestartSec=1
OOMScoreAdjust=-400

[Install]
WantedBy=multi-user.target
