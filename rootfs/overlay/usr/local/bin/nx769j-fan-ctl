#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""NX769J RedMagic Turbo Cooling Fan helper coordinated with nx769j-perf."""
import json
import os
import shutil
import subprocess
import sys

FAN_BIN = os.environ.get("NX769J_FAN_BIN", "/usr/local/bin/nx769j-fan")
PERF_BIN = os.environ.get("NX769J_PERF_BIN", "/usr/local/bin/nx769j-perf")
MODES = ("auto", "low", "med", "high", "max", "off")
CYCLE_ORDER = ("auto", "low", "med", "max", "off")


def query_status() -> dict:
    try:
        out = subprocess.check_output([FAN_BIN, "status", "--json"], text=True, timeout=3)
        st = json.loads(out.strip())
    except Exception as exc:
        return {
            "mode": "unavailable",
            "duty_percent": 0,
            "rpm": 0,
            "cpuss0_c": -1.0,
            "peak_cpu_c": -1.0,
            "peak_gpu_c": -1.0,
            "error": str(exc),
        }

    if os.path.isfile(PERF_BIN) and os.access(PERF_BIN, os.X_OK):
        try:
            pout = subprocess.check_output([PERF_BIN, "status", "--json"], text=True, timeout=2)
            pst = json.loads(pout.strip())
            st["perf_mode"] = pst.get("mode", "balanced")
            st["perf_label_zh"] = pst.get("label_zh", "均衡")
            st["fan_override"] = pst.get("fan_override", "profile")
        except Exception:
            pass
    return st


def set_mode(mode: str) -> dict:
    if mode not in MODES:
        raise ValueError(f"unsupported fan mode: {mode}")
    if os.path.isfile(PERF_BIN) and os.access(PERF_BIN, os.X_OK):
        ovr = "profile" if mode == "auto" else mode
        res = subprocess.run(
            [PERF_BIN, "fan-override", ovr, "--json"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=4,
            check=False,
        )
        if res.returncode == 0:
            return query_status()

    cmd = [FAN_BIN, mode] if os.geteuid() == 0 else ["sudo", "-n", FAN_BIN, mode]
    subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=4, check=False)
    return query_status()


def current_logical_mode(st: dict) -> str:
    ovr = st.get("fan_override")
    if ovr and ovr != "profile":
        return str(ovr)
    if ovr == "profile" or st.get("mode") == "auto":
        return "auto"
    duty = int(st.get("duty_percent", 0) or 0)
    if duty <= 0:
        return "off"
    if duty <= 25:
        return "low"
    if duty <= 65:
        return "med"
    if duty <= 85:
        return "high"
    return "max"


def maybe_notify(st: dict, requested: str) -> None:
    label = requested.upper() if requested != "auto" else "AUTO (Profile Curve)"
    rpm = st.get("rpm", 0)
    cpu = st.get("peak_cpu_c", -1.0)
    msg = f"Turbo Fan: {label} ({st.get('duty_percent', 0)}% · {rpm} RPM · CPU {cpu:.0f}°C)"
    notify = shutil.which("notify-send")
    if notify:
        subprocess.Popen(
            [notify, "-a", "Cooling Fan", "-t", "2500", "RedMagic Turbo Fan", msg],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )


def main() -> int:
    args = [a for a in sys.argv[1:] if a != "--notify"]
    notify = "--notify" in sys.argv[1:]
    op = args[0] if args else "status"

    if op == "status":
        st = query_status()
        st["logical_mode"] = current_logical_mode(st)
        print(json.dumps(st))
        return 0

    if op == "cycle":
        cur = current_logical_mode(query_status())
        nxt = CYCLE_ORDER[(CYCLE_ORDER.index(cur) + 1) % len(CYCLE_ORDER)] if cur in CYCLE_ORDER else "auto"
        st = set_mode(nxt)
        st["logical_mode"] = current_logical_mode(st)
        if notify:
            maybe_notify(st, nxt)
        print(json.dumps(st))
        return 0

    if op == "set" and len(args) >= 2:
        req = args[1].lower()
        if req not in MODES:
            sys.stderr.write(f"error: unknown fan mode '{req}'\n")
            return 2
        st = set_mode(req)
        st["logical_mode"] = current_logical_mode(st)
        if notify:
            maybe_notify(st, req)
        print(json.dumps(st))
        return 0

    sys.stderr.write("usage: nx769j-fan-ctl [status | cycle | set <auto|low|med|high|max|off>] [--notify]\n")
    return 2


if __name__ == "__main__":
    sys.exit(main())
