+SP<CWaylandOutput> Aquamarine::CWaylandTouch::resolveOutput(wl_proxy* surface) {
+    if (!backend)
+        return {};
+
+    if (surface) {
+        for (auto const& o : backend->outputs) {
+            if (o->waylandState.surface && o->waylandState.surface->resource() == surface) {
+                touchOutput = o;
+                if (!backend->focusedOutput.lock())
+                    backend->focusedOutput = o;
+                return o;
+            }
+        }
+    }
+
+    if (auto o = touchOutput.lock())
+        return o;
+
+    if (auto o = backend->focusedOutput.lock())
+        return o;
+
+    if (!backend->outputs.empty())
+        return backend->outputs.front();
+
+    return {};
+}
+
+Aquamarine::CWaylandTouch::CWaylandTouch(SP<CCWlTouch> touch_, Hyprutils::Memory::CWeakPointer<CWaylandBackend> backend_) : touch(touch_), backend(backend_) {
+    physicalSize = {71.0, 158.0};
+
+    if (!touch || !touch->resource())
+        return;
+
+    backend->backend->log(AQ_LOG_DEBUG, "New wayland touch wl_touch");
+
+    touch->setDown([this](CCWlTouch* r, uint32_t serial, uint32_t timeMs, wl_proxy* surface, int32_t id, wl_fixed_t x, wl_fixed_t y) {
+        if (!backend)
+            return;
+
+        backend->lastEnterSerial = serial;
+        const auto output        = resolveOutput(surface);
+        if (!output || output->waylandState.surfaceSize.x <= 0 || output->waylandState.surfaceSize.y <= 0)
+            return;
+
+        const Vector2D pos = {
+            std::clamp(wl_fixed_to_double(x) / output->waylandState.surfaceSize.x, 0.0, 1.0),
+            std::clamp(wl_fixed_to_double(y) / output->waylandState.surfaceSize.y, 0.0, 1.0),
+        };
+
+        activeSlots.insert(id);
+        events.down.emit(SDownEvent{
+            .timeMs  = timeMs,
+            .touchID = id,
+            .pos     = pos,
+        });
+    });
+
+    touch->setMotion([this](CCWlTouch* r, uint32_t timeMs, int32_t id, wl_fixed_t x, wl_fixed_t y) {
+        const auto output = resolveOutput();
+        if (!output || output->waylandState.surfaceSize.x <= 0 || output->waylandState.surfaceSize.y <= 0)
+            return;
+
+        const Vector2D pos = {
+            std::clamp(wl_fixed_to_double(x) / output->waylandState.surfaceSize.x, 0.0, 1.0),
+            std::clamp(wl_fixed_to_double(y) / output->waylandState.surfaceSize.y, 0.0, 1.0),
+        };
+
+        events.move.emit(SMotionEvent{
+            .timeMs  = timeMs,
+            .touchID = id,
+            .pos     = pos,
+        });
+    });
+
+    touch->setUp([this](CCWlTouch* r, uint32_t serial, uint32_t timeMs, int32_t id) {
+        (void)serial;
+        activeSlots.erase(id);
+        events.up.emit(SUpEvent{
+            .timeMs  = timeMs,
+            .touchID = id,
+        });
+    });
+
+    touch->setFrame([this](CCWlTouch* r) { events.frame.emit(); });
+
+    touch->setCancel([this](CCWlTouch* r) {
+        const auto slots = activeSlots;
+        activeSlots.clear();
+        for (const auto id : slots) {
+            events.cancel.emit(SCancelEvent{
+                .timeMs  = 0,
+                .touchID = id,
+            });
+        }
+    });
+}
