#!/usr/bin/env python3
"""
nx769j-imu — CLI status, live 6-axis monitor, and self-test tool for NX769J IMU.

Usage:
  nx769j-imu            # Human-readable snapshot
  nx769j-imu --json     # Raw JSON snapshot from /run/nx769j-imu/state.json
  nx769j-imu --watch    # Live 10 Hz 6-axis telemetry from /run/nx769j-imu/stream.sock
  nx769j-imu --check    # End-to-end automated hardware & evdev self-test (exit 0 = PASS)
"""

import argparse
import json
import math
import os
import socket
import struct
import sys
import time
from typing import Any, Dict

STATE_JSON_PATH = "/run/nx769j-imu/state.json"
STREAM_SOCK_PATH = "/run/nx769j-imu/stream.sock"
BY_ID_EVDEV = "/dev/input/by-id/platform-nx769j-lsm6dso-imu-event"


def read_state() -> Dict[str, Any]:
    if not os.path.exists(STATE_JSON_PATH):
        raise FileNotFoundError(f"{STATE_JSON_PATH} not found (is nx769j-imu-daemon running?)")
    with open(STATE_JSON_PATH, "r", encoding="utf-8") as f:
        return json.load(f)


def format_line(st: Dict[str, Any]) -> str:
    acc = st.get("accel_mps2", [0.0, 0.0, 0.0])
    gyr = st.get("gyro_rads", [0.0, 0.0, 0.0])
    gnorm = math.sqrt(sum(float(x) * float(x) for x in acc))
    return (
        f"accel=[{acc[0]:+7.3f}, {acc[1]:+7.3f}, {acc[2]:+7.3f}] m/s^2 (|g|={gnorm:6.3f})  "
        f"gyro=[{gyr[0]:+7.4f}, {gyr[1]:+7.4f}, {gyr[2]:+7.4f}] rad/s  "
        f"orient={st.get('orientation', '?'):<9s} tilt={st.get('tilt', '?'):<11s} "
        f"samples=({st.get('accel_samples', 0)},{st.get('gyro_samples', 0)})"
    )


def cmd_once(as_json: bool) -> int:
    st = read_state()
    if as_json:
        print(json.dumps(st, indent=2, sort_keys=True))
    else:
        print(f"Device      : NX769J LSM6DSO 6-Axis IMU (ADSP QSH service 400)")
        print(f"Connected   : {st.get('connected')} (node={st.get('adsp_node')}, port={st.get('adsp_port')})")
        print(f"Evdev Node  : {st.get('evdev_path')} ({BY_ID_EVDEV})")
        print(f"Sample Rate : {st.get('rate_hz')} Hz")
        print(f"Accel SUID  : 0x{st.get('accel_suid')}")
        print(f"Gyro  SUID  : 0x{st.get('gyro_suid')}")
        print(f"Telemetry   : {format_line(st)}")
    return 0


def cmd_watch() -> int:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.connect(STREAM_SOCK_PATH)
        buf = b""
        while True:
            chunk = s.recv(4096)
            if not chunk:
                break
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                if not line.strip():
                    continue
                st = json.loads(line.decode("utf-8", "replace"))
                print(format_line(st), flush=True)
    return 0


def cmd_check(timeout_s: float) -> int:
    deadline = time.monotonic() + timeout_s
    st: Dict[str, Any] = {}
    while time.monotonic() < deadline:
        try:
            st = read_state()
            if (
                st.get("connected")
                and int(st.get("accel_samples", 0)) >= 5
                and int(st.get("gyro_samples", 0)) >= 5
            ):
                break
        except Exception:
            pass
        time.sleep(0.25)
    else:
        print(f"FAIL: timed out waiting for streaming accel+gyro samples: {st}", file=sys.stderr)
        return 1

    acc = [float(x) for x in st.get("accel_mps2", [0.0, 0.0, 0.0])]
    gyr = [float(x) for x in st.get("gyro_rads", [0.0, 0.0, 0.0])]
    if not all(math.isfinite(x) for x in acc + gyr):
        print(f"FAIL: non-finite IMU values: accel={acc} gyro={gyr}", file=sys.stderr)
        return 1

    gnorm = math.sqrt(sum(x * x for x in acc))
    if not (7.5 <= gnorm <= 12.5):
        print(f"FAIL: |accel|={gnorm:.3f} m/s^2 outside [7.5, 12.5] m/s^2 ({acc})", file=sys.stderr)
        return 1

    evdev_path = BY_ID_EVDEV if os.path.exists(BY_ID_EVDEV) else str(st.get("evdev_path", ""))
    if not evdev_path or not os.path.exists(evdev_path):
        print(f"FAIL: evdev node missing ({BY_ID_EVDEV} / {evdev_path})", file=sys.stderr)
        return 1

    # Read at least one live SYN_REPORT frame from the CUSE evdev character device
    ev_fmt = "llHHi"
    ev_sz = struct.calcsize(ev_fmt)
    got_abs = set()
    got_syn = False
    fd = os.open(evdev_path, os.O_RDONLY | os.O_NONBLOCK)
    try:
        ev_deadline = time.monotonic() + 2.0
        while time.monotonic() < ev_deadline and not (got_syn and len(got_abs) >= 6):
            try:
                raw = os.read(fd, ev_sz * 32)
            except BlockingIOError:
                time.sleep(0.03)
                continue
            for off in range(0, (len(raw) // ev_sz) * ev_sz, ev_sz):
                _sec, _usec, etype, ecode, _eval = struct.unpack_from(ev_fmt, raw, off)
                if etype == 0x03 and 0 <= ecode <= 5:
                    got_abs.add(ecode)
                elif etype == 0x00 and ecode == 0:
                    got_syn = True
    finally:
        os.close(fd)

    if not (got_syn and len(got_abs) == 6):
        print(f"FAIL: incomplete evdev 6-axis frame on {evdev_path}: axes={got_abs} syn={got_syn}", file=sys.stderr)
        return 1

    print(f"PASS: {evdev_path} -> {format_line(st)}")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(description="NX769J 6-Axis IMU CLI & verifier")
    ap.add_argument("--json", action="store_true", help="Print JSON state")
    ap.add_argument("--watch", action="store_true", help="Stream live 6-axis samples")
    ap.add_argument("--check", action="store_true", help="Run automated PASS/FAIL self-test")
    ap.add_argument("--timeout", type=float, default=12.0, help="Self-test timeout seconds")
    args = ap.parse_args()

    try:
        if args.check:
            return cmd_check(args.timeout)
        if args.watch:
            return cmd_watch()
        return cmd_once(args.json)
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    sys.exit(main())
