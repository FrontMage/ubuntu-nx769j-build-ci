# NX769J/tiro experimental source-build fragment on arm64 defconfig.
# This does not certify boot, memory reservations or device wiring.
CONFIG_LOCALVERSION="-nx769j"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_ARCH_QCOM=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_PERF_EVENTS=y
CONFIG_HW_PERF_EVENTS=y
CONFIG_ARM_PMU=y
CONFIG_ARM_PMUV3=y
CONFIG_KPROBES=y
# CONFIG_UPROBES is promptless; UPROBE_EVENTS is the visible selector.
CONFIG_UPROBE_EVENTS=y
CONFIG_FRAME_POINTER=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_EXT4_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
# Capped at =m while defconfig has TYPEC=m (depends on TYPEC || TYPEC=n);
# USB/DP combo PHY is not needed to mount the UFS root filesystem.
CONFIG_PHY_QCOM_QMP_COMBO=m
CONFIG_PHY_QCOM_EUSB2_REPEATER=y
CONFIG_PHY_SNPS_EUSB2=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_SM_GCC_8650=y
CONFIG_SM_TCSRCC_8650=y
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_DRM=y
CONFIG_DRM_MSM=m
